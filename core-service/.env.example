# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/max_efficiency_db

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_AI_REQUEST_TOPIC=task.ai.request
KAFKA_AI_RESPONSE_TOPIC=task.ai.response
KAFKA_CONSUMER_GROUP=max-efficiency

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600