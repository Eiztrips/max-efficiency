### ===== MAIN APP TESTS =====
### Base URL
@baseUrl = http://localhost:8000

### ===== HEALTH CHECKS =====

### Проверка корневого эндпоинта
GET {{baseUrl}}/
Content-Type: application/json

### Приветствие с именем
GET {{baseUrl}}/hello/Максим
Content-Type: application/json

### ===== INTEGRATION TESTS =====

### Создать пользователя
POST {{baseUrl}}/api/v1/users
Content-Type: application/json

{
  "max_user_id": 1001,
  "username": "integration_test_user"
}

### Создать категорию для пользователя
POST {{baseUrl}}/api/v1/categories
Content-Type: application/json

{
  "user_id": 1,
  "name": "Тестовая категория",
  "description": "Категория для интеграционных тестов"
}

### Создать тег в категории
POST {{baseUrl}}/api/v1/tags
Content-Type: application/json

{
  "category_id": 1,
  "name": "Тестовый тег",
  "color": "#00FF00"
}

### Создать задачу
POST {{baseUrl}}/api/v1/tasks
Content-Type: application/json

{
  "user_id": "1",
  "title": "Интеграционная задача",
  "category_id": 1,
  "description": "Задача для интеграционного теста",
  "is_completed": false
}

### Получить все данные пользователя
GET {{baseUrl}}/api/v1/users/user/1/categories
Content-Type: application/json

###
GET {{baseUrl}}/api/v1/users/user/1/tags
Content-Type: application/json

###
GET {{baseUrl}}/api/v1/users/user/1/tasks
Content-Type: application/json

### Обновить пользователя
PATCH {{baseUrl}}/api/v1/users/1001
Content-Type: application/json

{
  "username": "updated_integration_user"
}

### Добавить пользователя в категорию
PATCH {{baseUrl}}/api/v1/categories/1/users/1
Content-Type: application/json

### Получить задачи с фильтрацией
GET {{baseUrl}}/api/v1/tasks?user_id=1&category_id=1&is_completed=false
Content-Type: application/json

